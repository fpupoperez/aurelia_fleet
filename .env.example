# Copy to .env and replace the development secrets before any shared deployment.
# Providers are only fake or litellm. A local Ollama, vLLM, or llama.cpp server
# is LiteLLM with LLM_API_BASE set to its OpenAI-compatible URL.

# Docker deployment. Compose reads infra/.env. Tests and CI force both providers to fake.
# ollama pull llama3.1:8b
# ollama pull all-minilm
# nomic-embed-text returns 768 values. The column is vector(384), so it is not used.

LLM_PROVIDER=litellm
EMBEDDING_PROVIDER=litellm
LLM_MODEL=openai/llama3.1:8b
LLM_API_BASE=http://host.docker.internal:11434/v1
LLM_API_KEY=ollama
LLM_API_VERSION=

# Cloud chat, same file. Leave LLM_API_BASE empty so LiteLLM uses the vendor host.
# Keep the EMBEDDING_* lines above: those models must return 384 values.
# OpenAI:    LLM_MODEL=openai/gpt-4o                 LLM_API_KEY=sk-...
# Claude:    LLM_MODEL=anthropic/claude-sonnet-4-5   LLM_API_KEY=sk-ant-...
# Gemini:    LLM_MODEL=gemini/gemini-2.5-flash       LLM_API_KEY=...
# Azure:     LLM_MODEL=azure/<deployment> LLM_API_BASE=https://<resource>.openai.azure.com LLM_API_VERSION=2024-10-21
EMBEDDING_MODEL=openai/all-minilm
EMBEDDING_API_BASE=http://host.docker.internal:11434/v1
EMBEDDING_API_KEY=ollama
EMBEDDING_DIMENSION=384
PDF_READING_ORDER=geometry

LANGFUSE_PUBLIC_KEY=pk-lf-aurelia-dev-public
LANGFUSE_SECRET_KEY=sk-lf-aurelia-dev-secret
LANGFUSE_HOST=http://localhost:3000

AUTH_REQUIRED=false
JWT_SECRET=dev-only-not-a-production-secret
DATABASE_URL=postgresql+psycopg://aurelia:aurelia@localhost:5432/aurelia
REDIS_URL=redis://localhost:6379/0
